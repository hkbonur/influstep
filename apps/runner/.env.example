# Where the backend's HTTP routes live (CONVEX_SITE_ORIGIN of the docker backend).
CONVEX_SITE_URL=http://127.0.0.1:3221
# Must match the RUNNER_TOKEN env var on the Convex deployment.
RUNNER_TOKEN=local-runner-token
# mock | real (ADR 0002). Real needs the keys below and a signed-in browser profile.
PROVIDERS_MODE=mock
RUNNER_NAME=laptop

# Real providers
ELEVENLABS_API_KEY=
# HeyGen API (Avatar IV): animates the persona's portrait to its voice for every avatar take and Loom-style bubble.
HEYGEN_API_KEY=
# A YouTube Data API access token with youtube.upload scope (OAuth playground works for a first run).
YOUTUBE_ACCESS_TOKEN=
