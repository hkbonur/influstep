{
  "name": "@influstep/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "lint:check": "oxlint ./src",
    "lint:fix": "oxlint --fix ./src",
    "tsc:check": "tsc --noEmit",
    "format:fix": "oxfmt --config ../../.oxfmtrc.json --write ./src",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check ./src"
  },
  "dependencies": {
    "@influstep/shared": "workspace:*",
    "playwright": "1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
