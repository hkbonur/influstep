{
  "name": "@influstep/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint:check": "oxlint ./src ./worker",
    "lint:fix": "oxlint --fix ./src ./worker",
    "gen:routes": "node --experimental-strip-types scripts/gen-route-tree.ts",
    "tsc:check": "pnpm gen:routes && tsc --noEmit && tsc --noEmit -p ./worker/tsconfig.json",
    "format:fix": "oxfmt --config ../../.oxfmtrc.json --write ./src ./worker",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check ./src ./worker",
    "predeploy": "pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@influstep/convex": "workspace:*",
    "@influstep/shared": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-router": "^1.170.38",
    "clsx": "2.1.1",
    "convex": "^1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-generator": "1.167.38",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxc-transform-react": "0.150.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.70.0"
  }
}
