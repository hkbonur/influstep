# ─── Local development (.env.local) ──────────────────────────────────────────
# `pnpm backend:up` writes these for the docker backend; a cloud deployment
# uses CONVEX_DEPLOYMENT instead.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3220
CONVEX_SELF_HOSTED_ADMIN_KEY=

# ─── Deployment env vars (`pnpm exec convex env set KEY VALUE`) ─────────────
# mock | real (ADR 0002). Real adapters throw when their key is missing.
PROVIDERS_MODE=mock
# Shared secret the runner and the worker present on /runner/* and /links/*.
RUNNER_TOKEN=change-me
# Where tracked links send viewers.
SPONSOR_URL=https://formstep.io
SPONSOR_NAME=Formstep

# Real providers
ANTHROPIC_API_KEY=
# Conversions: Formstep's PostHog project (docs/plan.md, "What Formstep must emit").
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
# Discount-code redemptions: Polar, read only. https://api.polar.sh for the
# live organization, https://sandbox-api.polar.sh for the sandbox one. The
# token is an organization access token that can read discounts and orders.
POLAR_API_BASE=https://api.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
YOUTUBE_API_KEY=
